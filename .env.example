# ============================================
# TELEGRAM BOT CONFIGURATION
# ============================================
# Obtén tu token de @BotFather en Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# URL del webhook (solo para producción con Cloud Run)
# Formato: https://tu-app-name.run.app/webhook
TELEGRAM_WEBHOOK_URL=

# ============================================
# MONGODB ATLAS CONFIGURATION
# ============================================
# URI de conexión de MongoDB Atlas (Free Tier M0)
# Formato: mongodb+srv://username:password@cluster.mongodb.net/
MONGODB_URI=mongodb+srv://usuario:password@cluster0.xxxxx.mongodb.net/

# Nombre de la base de datos
MONGODB_DB_NAME=pharmacy_bot

# ============================================
# REDIS/UPSTASH CONFIGURATION
# ============================================
# URL de conexión de Upstash Redis (Free Tier)
# Formato: redis://default:password@host:port
REDIS_URL=redis://default:password@host.upstash.io:6379

# TTL del cache en segundos (default: 6 horas = 21600)
CACHE_TTL=21600

# ============================================
# GROQ AI CONFIGURATION
# ============================================
# API Key de Groq (obtener en console.groq.com)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Modelo a usar (llama3-70b-8192, mixtral-8x7b-32768)
GROQ_MODEL=llama3-70b-8192

# ============================================
# GOOGLE CLOUD CONFIGURATION
# ============================================
# ID del proyecto de Google Cloud
GOOGLE_CLOUD_PROJECT=tu-proyecto-id

# Ruta al archivo de credenciales (opcional para local)
GOOGLE_APPLICATION_CREDENTIALS=

# ============================================
# APPLICATION CONFIGURATION
# ============================================
# Entorno: development, staging, production
ENVIRONMENT=development

# Nivel de logging: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Puerto para el servidor web (webhooks)
PORT=8080

# ============================================
# RATE LIMITING
# ============================================
# Máximo de peticiones por usuario por minuto
RATE_LIMIT_PER_MINUTE=10

# Máximo de búsquedas por usuario por día
RATE_LIMIT_PER_DAY=100

# ============================================
# SCRAPER CONFIGURATION
# ============================================
# Tiempo de espera entre peticiones (segundos)
SCRAPER_DELAY=2

# Timeout para peticiones HTTP (segundos)
SCRAPER_TIMEOUT=30

# Número máximo de reintentos
SCRAPER_MAX_RETRIES=3

# User-Agent para las peticiones
SCRAPER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36

# ============================================
# MONITORING & ANALYTICS
# ============================================
# Sentry DSN para monitoreo de errores (opcional)
SENTRY_DSN=

# Habilitar analytics (true/false)
ENABLE_ANALYTICS=true

# ============================================
# FEATURE FLAGS
# ============================================
# Habilitar cache
ENABLE_CACHE=true

# Habilitar IA (Groq)
ENABLE_AI=true

# Habilitar modo debug
DEBUG=false

# ============================================
# PHARMACY URLS (Opcional - para override)
# ============================================
CRUZ_VERDE_URL=https://www.cruzverde.cl
SALCOBRAND_URL=https://www.salcobrand.cl
FARMACIAS_AHUMADA_URL=https://www.farmaciasahumada.cl